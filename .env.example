# LLM Provider (openrouter / mistral / claude)
LLM_PROVIDER=mistral
OPENROUTER_API_KEY=
# Optional OpenRouter model slug override (default: qwen/qwen3-235b-a22b-2507)
OPENROUTER_MODEL=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Experimental: skip the Synthesizer's LLM call and let the Writer analyze the
# evidence directly (one call instead of two). Off by default; see ADR-010.
PIPELINE_MERGED_WRITER=false

# TTS via Mistral Voxtral (uses MISTRAL_API_KEY)
# Optional overrides (defaults: voxtral-mini-tts-latest, en_paul_neutral)
MISTRAL_TTS_MODEL=
MISTRAL_TTS_VOICE=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# CORS — frontend origin(s); comma-separate several, or use "onrender.com" for any Render subdomain
FRONTEND_URL=http://localhost:4200

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# LangSmith (optional — leave empty to skip tracing and eval dashboard)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=voxpopuli-evals

# Eval config
EVAL_API_URL=http://localhost:3000
