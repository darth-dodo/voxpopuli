# LLM Provider (openrouter / mistral / claude)
LLM_PROVIDER=mistral
OPENROUTER_API_KEY=
# Optional OpenRouter model slug override (default: qwen/qwen3-235b-a22b-2507)
OPENROUTER_MODEL=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# TTS via OpenRouter audio output (uses OPENROUTER_API_KEY)
# Optional overrides (defaults: openai/gpt-audio-mini, onyx)
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=

# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# CORS — set to production frontend URL on Render
FRONTEND_URL=http://localhost:4200

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# LangSmith (optional — leave empty to skip tracing and eval dashboard)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=voxpopuli-evals

# Eval config
EVAL_API_URL=http://localhost:3000
EVAL_JUDGE_PROVIDER=mistral

# Multi-Agent Pipeline (M8)
# Set to 'true' to enable the multi-agent pipeline by default.
# When false, the legacy single ReAct agent is used.
USE_MULTI_AGENT=false
